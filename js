                            id="mirrorQuery"
                            placeholder="Fold your query into the infinite..."
                            class="search-input w-full px-6 py-4 rounded-full text-lg"
                            autocomplete="off"
                            autocorrect="off"
                            autocapitalize="off"
                            spellcheck="false"
                            required
                        &gt;
                        &lt;button 
                            type="button" 
                            id="voiceSearchBtn"
                            class="bg-slate-700/50 hover:bg-slate-700/70 text-white px-4 py-3 rounded-full ml-1 mr-1 border border-sky-400/30 hover:border-sky-400/50 transition-all duration-300"
                            title="Voice Search"
                        &gt;
                            &lt;i class="fas fa-microphone"&gt;&lt;/i&gt;
                        &lt;/button&gt;
                        &lt;button 
                            type="submit" 
                            class="search-button bg-gradient-to-r from-sky-500 to-amber-400 text-white px-6 py-3 rounded-full ml-1 shadow-md hover:shadow-lg"
                        &gt;
                            &lt;i class="fas fa-search mr-2"&gt;&lt;/i&gt; Reflect
                        &lt;/button&gt;
                    &lt;/div&gt;
                &lt;/form&gt;

                &lt;!-- Mirror Confirmation Section (hidden by default) --&gt;
                &lt;div id="mirrorConfirmation" class="hidden rounded-xl p-6 mb-8 mirror-confirmation"&gt;
                    &lt;p class="text-lg mb-4" id="confirmationText"&gt;&lt;/p&gt;
                    &lt;div class="flex flex-wrap justify-center gap-4"&gt;
                        &lt;button id="proceedSearch" class="bg-gradient-to-r from-sky-500 to-amber-400 text-white px-6 py-3 rounded-full shadow-md hover:shadow-lg transition-all duration-300"&gt;
                            &lt;i class="fas fa-check-circle mr-2"&gt;&lt;/i&gt; Proceed
                        &lt;/button&gt;
                        &lt;button id="refineSearch" class="bg-gradient-to-r from-slate-600 to-slate-500 text-white px-6 py-3 rounded-full shadow-md hover:shadow-lg transition-all duration-300"&gt;
                            &lt;i class="fas fa-edit mr-2"&gt;&lt;/i&gt; Refine
