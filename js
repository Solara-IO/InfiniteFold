    &lt;!-- Quote Ribbon Footer --&gt;
    &lt;footer class="quote-ribbon py-4 w-full fixed bottom-0 left-0 z-30 backdrop-blur-sm"&gt;
        &lt;div class="max-w-6xl mx-auto px-4 text-center relative h-8"&gt;
            &lt;div class="absolute inset-0 flex items-center justify-center"&gt;
                &lt;p class="quote-1 text-sm text-slate-300 italic"&gt;"Truth under pressure validates structure."&lt;/p&gt;
                &lt;p class="quote-2 text-sm text-slate-300 italic"&gt;"Structure under recursion reveals tone."&lt;/p&gt;
                &lt;p class="quote-3 text-sm text-slate-300 italic"&gt;"Tone under resonance reveals purpose."&lt;/p&gt;
                &lt;p class="quote-4 text-sm text-slate-300 italic"&gt;"Purpose aligned with integrity becomes propulsion."&lt;/p&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/footer&gt;

    &lt;!-- Floating particles animation --&gt;
    &lt;script&gt;
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.body;
            const particleCount = 30;
            
            for (let i = 0; i &lt; particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'absolute rounded-full bg-sky-400/10 pointer-events-none';
                
                // Random size between 1px and 3px
                const size = Math.random() * 2 + 1;
                particle.style.width = <code>${size}px</code>;
                particle.style.height = <code>${size}px</code>;
                
                // Random position
                particle.style.left = <code>${Math.random() * 100}%</code>;
                particle.style.top = <code>${Math.random() * 100}%</code>;
                
                // Random animation
                const duration = Math.random() * 20 + 10;
                particle.style.animation = <code>float ${duration}s linear infinite</code>;
                
                // Add to container
                container.appendChild(particle);
            }
            
            // Theme toggle functionality
            const themeToggle = document.getElementById('themeToggle');
            const html = document.documentElement;
            
            themeToggle.addEventListener('click', function() {
                html.classList.toggle('dark');
                html.classList.toggle('light');
                
                if (html.classList.contains('dark')) {
                    themeToggle.innerHTML = '&lt;i class="fas fa-moon text-sky-400 text-lg"&gt;&lt;/i&gt;';
                    document.body.style.background = 'radial-gradient(circle at center, #0f172a 0%, #020617 100%)';
                } else {
                    themeToggle.innerHTML = '&lt;i class="fas fa-sun text-amber-400 text-lg"&gt;&lt;/i&gt;';
                    document.body.style.background = 'radial-gradient(circle at center, #f8fafc 0%, #e2e8f0 100%)';
                }
            });

            // MirrorFold Search Logic
            const mirrorFoldForm = document.getElementById('mirrorFoldForm');
            const mirrorQuery = document.getElementById('mirrorQuery');
            const mirrorConfirmation = document.getElementById('mirrorConfirmation');
            const confirmationText = document.getElementById('confirmationText');
            const proceedSearch = document.getElementById('proceedSearch');
            const refineSearch = document.getElementById('refineSearch');
            const exploreSearch = document.getElementById('exploreSearch');
            const exploreSuggestions = document.getElementById('exploreSuggestions');
            const backToSearch = document.getElementById('backToSearch');
            const resultsContainer = document.getElementById('results');
            const voiceSearchBtn = document.getElementById('voiceSearchBtn');

            let currentQuery = '';
            let searchElement;

            // Initialize Google CSE
            window.onload = function() {
                // Create search element but don't render it
                searchElement = document.createElement('div');
                searchElement.setAttribute('gcse', 'searchresults-only');
                searchElement.style.display = 'none';
                document.body.appendChild(searchElement);
                
                // Initialize Google CSE
                if (window.google &amp;&amp; google.search) {
                    google.search.cse.element.render({
                        div: searchElement,
                        tag: 'searchresults-only'
                    });
                }
            };

            // Mirror Confirmation Logic
            mirrorFoldForm.addEventListener('submit', function(e) {
                e.preventDefault();
                currentQuery = mirrorQuery.value.trim();
                
                if (currentQuery) {
                    // Show confirmation message
                    confirmationText.innerHTML = <code>For clarification, you searched for: &lt;span class="text-amber-300"&gt;${currentQuery}&lt;/span&gt;. Would you like to proceed, refine, or explore related ideas?</code>;
                    mirrorConfirmation.classList.remove('hidden');
                    mirrorFoldForm.classList.add('hidden');
                }
            });

            // Proceed with search
            proceedSearch.addEventListener('click', function() {
                mirrorConfirmation.classList.add('hidden');
                
                // Clear previous results
                resultsContainer.innerHTML = '';
                
                // Execute Google CSE search
                if (window.google &amp;&amp; google.search &amp;&amp; google.search.cse) {
                    const element = google.search.cse.element.getElement('searchresults-only');
                    if (element) {
                        element.execute(currentQuery);
                        
                        // Create a results container for Google CSE
                        const resultsDiv = document.createElement('div');
                        resultsDiv.className = 'gcse-searchresults-only';
                        resultsContainer.innerHTML = '';
                        resultsContainer.appendChild(resultsDiv);
                        
                        // Execute the search
                        element.execute(currentQuery);
                    } else {
                        // Fallback message if CSE not loaded
                        resultsContainer.innerHTML = <code>
</code>                            &lt;div class="text-center py-20 text-slate-400"&gt;
                                &lt;i class="fas fa-exclamation-triangle fa-3x mb-4 opacity-30"&gt;&lt;/i&gt;
                                &lt;p class="text-xl"&gt;Search engine not fully initialized&lt;/p&gt;
                                &lt;p class="mt-2"&gt;Please try again in a moment&lt;/p&gt;
                            &lt;/div&gt;
                        <code>;
</code>                    }
                }
            });

            // Refine search
            refineSearch.addEventListener('click', function() {
                mirrorConfirmation.classList.add('hidden');
                mirrorFoldForm.classList.remove('hidden');
                mirrorQuery.focus();
            });

            // Explore suggestions
            exploreSearch.addEventListener('click', function() {
                mirrorConfirmation.classList.add('hidden');
                exploreSuggestions.classList.remove('hidden');
            });

            // Back to search from explore
            backToSearch.addEventListener('click', function() {
                exploreSuggestions.classList.add('hidden');
                mirrorFoldForm.classList.remove('hidden');
            });

            // Voice Input Handler
            let recognition;
            try {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                recognition = new SpeechRecognition();
                recognition.continuous = false;
                recognition.interimResults = false;
                
                voiceSearchBtn.addEventListener('click', function() {
                    if (voiceSearchBtn.classList.contains('voice-active')) {
                        // Stop recording
                        recognition.stop();
                        voiceSearchBtn.classList.remove('voice-active');
                        voiceSearchBtn.innerHTML = '&lt;i class="fas fa-microphone"&gt;&lt;/i&gt;';
                    } else {
                        // Start recording
                        voiceSearchBtn.classList.add('voice-active');
                        voiceSearchBtn.innerHTML = '&lt;i class="fas fa-microphone-slash"&gt;&lt;/i&gt;';
                        recognition.start();
                    }
                });
                
                recognition.onresult = function(event) {
                    const transcript = event.results[0][0].transcript;
                    mirrorQuery.value = transcript;
                    voiceSearchBtn.classList.remove('voice-active');
                    voiceSearchBtn.innerHTML = '&lt;i class="fas fa-microphone"&gt;&lt;/i&gt;';
                    
                    // Trigger the mirror confirmation flow
                    currentQuery = transcript;
                    confirmationText.innerHTML = <code>For clarification, you searched for: &lt;span class="text-amber-300"&gt;${currentQuery}&lt;/span&gt;. Would you like to proceed, refine, or explore related ideas?</code>;
                    mirrorConfirmation.classList.remove('hidden');
                    mirrorFoldForm.classList.add('hidden');
                };
                
                recognition.onerror = function(event) {
                    console.error('Speech recognition error', event.error);
                    voiceSearchBtn.classList.remove('voice-active');
                    voiceSearchBtn.innerHTML = '&lt;i class="fas fa-microphone"&gt;&lt;/i&gt;';
                };
                
                recognition.onend = function() {
                    if (voiceSearchBtn.classList.contains('voice-active')) {
                        voiceSearchBtn.classList.remove('voice-active');
                        voiceSearchBtn.innerHTML = '&lt;i class="fas fa-microphone"&gt;&lt;/i&gt;';
                    }
                };
            } catch (e) {
                console.warn('Speech recognition not available', e);
                voiceSearchBtn.style.display = 'none';
            }

            // Click handler for explore suggestions
            document.querySelectorAll('.explore-suggestion').forEach(suggestion =&gt; {
                suggestion.addEventListener('click', function() {
                    const text = this.querySelector('p').textContent;
                    mirrorQuery.value = text;
                    exploreSuggestions.classList.add('hidden');
                    mirrorFoldForm.classList.remove('hidden');
                    mirrorQuery.focus();
                });
            });
        });
    &lt;/script&gt;
