                &lt;/div&gt;

                &lt;!-- Search Results Container --&gt;
                &lt;div class="rounded-xl p-2 holographic-border backdrop-blur-sm"&gt;
                    &lt;div id="results" class="search-results bg-slate-800/50 rounded-lg p-6 border border-sky-400/20"&gt;
                        &lt;div class="text-center py-20 text-slate-400"&gt;
                            &lt;i class="fas fa-search fa-3x mb-4 opacity-30"&gt;&lt;/i&gt;
