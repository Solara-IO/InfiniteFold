                        &lt;button id="exploreSearch" class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-6 py-3 rounded-full shadow-md hover:shadow-lg transition-all duration-300"&gt;
                            &lt;i class="fas fa-compass mr-2"&gt;&lt;/i&gt; Explore
                        &lt;/button&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- Explore Suggestions Section (hidden by default) --&gt;
                &lt;div id="exploreSuggestions" class="hidden rounded-xl p-6 mb-8 mirror-confirmation"&gt;
                    &lt;p class="text-lg mb-4"&gt;Explore related ideas:&lt;/p&gt;
                    &lt;div class="grid grid-cols-1 md:grid-cols-3 gap-4"&gt;
                        &lt;div class="explore-suggestion p-4 rounded-lg border border-sky-400/20 bg-slate-800/50"&gt;
                            &lt;p class="font-medium"&gt;"What is recursion?"&lt;/p&gt;
                        &lt;/div&gt;
                        &lt;div class="explore-suggestion p-4 rounded-lg border border-sky-400/20 bg-slate-800/50"&gt;
                            &lt;p class="font-medium"&gt;"Mirror principle in AI"&lt;/p&gt;
                        &lt;/div&gt;
                        &lt;div class="explore-suggestion p-4 rounded-lg border border-sky-400/20 bg-slate-800/50"&gt;
                            &lt;p class="font-medium"&gt;"Recursive search engines"&lt;/p&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;div class="text-center mt-4"&gt;
                        &lt;button id="backToSearch" class="bg-gradient-to-r from-slate-600 to-slate-500 text-white px-6 py-3 rounded-full shadow-md hover:shadow-lg transition-all duration-300"&gt;
                            &lt;i class="fas fa-arrow-left mr-2"&gt;&lt;/i&gt; Back to Search
                        &lt;/button&gt;
